{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts/*.ts", "vite.config.ts"]
}
