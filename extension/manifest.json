{
  "manifest_version": 3,
  "name": "Skills-Harness · AI History Bridge",
  "version": "0.1.5",
  "description": "将你授权的 AI 历史安全交给本机 Skills-Harness。Send selected AI histories to your local Skills-Harness app.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:42837/*"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Skills-Harness"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:42837"
  }
}
