{
  "name": "skills-harness",
  "productName": "Skills-Harness",
  "version": "0.1.14",
  "private": true,
  "description": "A local-first engineering harness that distills massive AI chat histories into reusable Agent Skills via TF-IDF/cosine pre-filtering and budget-controlled LLM synthesis.",
  "author": "skills-harness contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis portable --publish never",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:all": "npm run build && electron-builder --publish never",
    "release:source": "node scripts/source-archive.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "jose": "6.2.15",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "org.skills-harness.desktop",
    "productName": "Skills-Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "OPEN_SOURCE_ATTRIBUTIONS.md",
      "third_party/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/branding/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skills-Harness",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/branding/icon.ico",
      "uninstallerIcon": "src/branding/icon.ico",
      "artifactName": "skills-harness-Setup-${version}-${arch}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "portable": {
      "artifactName": "skills-harness-${version}-Windows-${arch}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
